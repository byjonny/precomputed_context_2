# Copy this file to .env and fill in your OpenRouter key.
# .env is ignored by git.

OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional OpenRouter metadata headers.
OPENROUTER_APP_TITLE=insights-repetition
OPENROUTER_HTTP_REFERER=http://localhost

# Optional script settings.
OPENROUTER_CONFIG=configs/openrouter_smoke.json
PYTHON_BIN=python3
