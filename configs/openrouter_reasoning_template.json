{
  "dataset": "trs-deepmath",
  "provider": "openrouter",
  "model": "openai/o4-mini",
  "mode": "oracle",
  "eval_offset": 0,
  "sample_size": 10,
  "k_values": [0, 1, 2, 3, 5],
  "temperature": 0,
  "max_tokens": 4096,
  "reasoning": {
    "effort": "medium"
  },
  "request_timeout_s": 120,
  "max_retries": 1,
  "retry_backoff_s": 5,
  "continue_on_error": true,
  "requests_per_minute": 20,
  "output_root": "results"
}
