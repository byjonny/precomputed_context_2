{
  "dataset": "trs-deepmath",
  "provider": "openrouter",
  "model": "deepseek/deepseek-v4-flash",
  "mode": "oracle",
  "eval_offset": 3,
  "sample_size": 300,
  "seed": 1021,
  "shuffle_records": true,
  "temperature": 0,
  "max_tokens": 20000,
  "max_token_warning_ratio": 0.95,
  "reasoning": {
    "effort": "none"
  },
  "request_timeout_s": 120,
  "max_retries": 1,
  "retry_backoff_s": 5,
  "continue_on_error": true,
  "parallel_workers": 3,
  "progress_summary_interval": 300,
  "requests_per_minute": 10,
  "output_root": "results",
  "experiments": {
    "0": "{q, q}",
    "1": "{q, i, sep, q, i}",
    "2": "{q, sep, q, i}"
  },
  "prompt_config": {
    "hint_delimiter": "\n\n--- same hint repeated ---\n\n"
}
}
