{
  "dataset": "trs-deepmath",
  "data_path": "data/trs/corpora/deepmath_103k_oss_skill_corpus.jsonl.gz",
  "evaluator": "exact",
  "provider": "openrouter",
  "model": "deepseek/deepseek-v4-flash",
  "mode": "oracle",
  "k_values": [
    0,
    1,
    2
  ],
  "sample_size": 300,
  "eval_offset": 3,
  "library_size": 1000,
  "repeats": 1,
  "seed": 1021,
  "temperature": 0,
  "max_tokens": 20000,
  "output_root": "results",
  "shuffle_records": true,
  "requests_per_minute": 10,
  "skip_answer_leakage": true,
  "show_progress": true,
  "reasoning": {
    "effort": "none"
  },
  "request_timeout_s": 120,
  "max_retries": 1,
  "retry_backoff_s": 5,
  "continue_on_error": true,
  "max_token_warning_ratio": 0.95,
  "parallel_workers": 3
}